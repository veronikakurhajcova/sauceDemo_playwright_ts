{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "tests/**/*",
    "pages/**/*",
    "helpers/**/*",
    "fixtures/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}